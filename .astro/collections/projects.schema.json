{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "default": "Untitled Project",
      "type": "string"
    },
    "description": {
      "default": "No description provided",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "default": "2026-02-19T05:05:07.007Z",
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "default": [],
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "repositoryUrl": {},
    "projectUrl": {},
    "demoUrl": {},
    "demoURL": {},
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "image": {},
    "imageAlt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hideCoverImage": {
      "type": "boolean"
    },
    "hideTOC": {
      "type": "boolean"
    },
    "showTOC": {
      "type": "boolean"
    },
    "draft": {
      "type": "boolean"
    },
    "noIndex": {
      "type": "boolean"
    },
    "featured": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "categories",
    "repositoryUrl",
    "projectUrl",
    "demoUrl",
    "demoURL",
    "image"
  ],
  "additionalProperties": false
}