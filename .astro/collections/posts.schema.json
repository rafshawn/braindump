{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "default": "Untitled Post",
      "type": "string"
    },
    "description": {
      "default": "No description provided",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "default": "2026-02-19T05:05:07.006Z",
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "image": {},
    "imageOG": {
      "type": "boolean"
    },
    "imageAlt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hideCoverImage": {
      "type": "boolean"
    },
    "hideTOC": {
      "type": "boolean"
    },
    "showTOC": {
      "type": "boolean"
    },
    "targetKeyword": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "noIndex": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "image"
  ],
  "additionalProperties": false
}